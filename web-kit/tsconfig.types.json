{
  "//": "Type-checks the hand-written declarations (src/*.d.ts) against test/types/consumer.ts with ui-kit's TypeScript: pnpm check",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": []
  },
  "include": ["test/types/consumer.ts", "src/*.d.ts"]
}
